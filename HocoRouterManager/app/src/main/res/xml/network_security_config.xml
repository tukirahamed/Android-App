<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is allowed ONLY for typical private router addresses. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.1</domain>
        <domain includeSubdomains="false">192.168.101.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.8.1</domain>
        <domain includeSubdomains="false">192.168.10.1</domain>
        <domain includeSubdomains="false">192.168.43.1</domain>
        <domain includeSubdomains="false">192.168.254.1</domain>
    </domain-config>
</network-security-config>
